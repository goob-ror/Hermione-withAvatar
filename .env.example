# Runtime configuration. Copy to `.env` (gitignored) and edit there.
# None of these are secrets by default — put actual tokens in `.env`,
# never in this file.

# ── Models ──────────────────────────────────────────────────────────────────
# Local Ollama daemon. Also the implicit starter provider in the UI.
OLLAMA_HOST=http://127.0.0.1:11434

# API keys for hosted models (all optional). A key set here shows up under
# "Detected" in Model providers; the provider then reads it from the env —
# it is never copied into .hermione/providers.json. If one runs out of quota,
# Hermione fails over to the next available provider automatically.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=

# ── Agent sandbox ───────────────────────────────────────────────────────────
# Filesystem root every fs_* tool is locked to. Empty = the project directory.
AGENT_ROOT=

# Hosts `site_inspect` / `page_open` may reach. "*" = any public site.
# Automatic tools never reach localhost / LAN / cloud-metadata addresses,
# whatever this says.
AGENT_ALLOWED_DOMAINS=*

# Extra Host names the API answers on, comma-separated. Leave empty unless you
# open Hermione from another device (e.g. "192.168.1.20,hermione.lan").
# Loopback (localhost / 127.0.0.1 / [::1]) is always allowed.
HERMIONE_ALLOWED_HOSTS=

# ── Web search ──────────────────────────────────────────────────────────────
# Searches work with no key (DuckDuckGo, then Bing). Optional extras:

# Google Custom Search API
# Key: https://console.developers.google.com/apis/credentials
# Engine: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=

# Your OWN SearXNG instance (public instances answer bots with a captcha).
SEARXNG_INSTANCE=

# Chrome used for the optional "search through a Chrome profile" mode
# (Browser button). Empty = auto-detect the installed Chrome.
CHROME_PATH=

# ── Storage ─────────────────────────────────────────────────────────────────
# Where Hermione keeps providers, sessions, usage, caches and her Chrome
# profile. Default: <project>/.hermione — gitignored.
HERMIONE_CONFIG_DIR=
