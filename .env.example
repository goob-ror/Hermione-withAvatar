# Runtime configuration. Copy to `.env` (gitignored) and edit there.
# None of these are secrets by default — put actual tokens in `.env`,
# never in this file.

# Local Ollama daemon. Also the implicit starter provider in the UI.
OLLAMA_HOST=http://127.0.0.1:11434

# Filesystem root every fs_* tool is locked to. Empty = the project directory.
AGENT_ROOT=

# Comma-separated hosts `site_inspect` / `page_open` may touch.
# Set to "*" or "unrestricted" to allow all domains (unrestricted mode).
# Nothing loads unless it is named here OR set to "*".
AGENT_ALLOWED_DOMAINS=*

# Google Custom Search API (optional, for web_search tool)
# Get API key: https://console.developers.google.com/apis/credentials
# Create search engine: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=

# SearXNG instance (fallback for web_search, default: https://searx.be)
SEARXNG_INSTANCE=https://searx.be

# Where the provider store lives (custom endpoints + API tokens).
# Default: <project>/.hermione — gitignored.
HERMIONE_CONFIG_DIR=
